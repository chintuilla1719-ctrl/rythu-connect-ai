		"multer": "^1.4.5-lts.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"knip": "^6.15.0",
		"oxlint": "^1.68.0",
